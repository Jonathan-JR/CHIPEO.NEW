local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local OWNER_KEY = "ENRIQUEVIP"
local CLIENT_KEY = "ENRIQUECLIENT"

local BLUE = Color3.fromRGB(0, 145, 255)
local DARK = Color3.fromRGB(12, 20, 38)
local PANEL = Color3.fromRGB(20, 33, 57)
local WHITE = Color3.fromRGB(245, 248, 255)

local accessType
local farmEnabled = false
local farmTarget = "Monedas"
local destinations = {}

local old = playerGui:FindFirstChild("Chipeo")
if old then
    old:Destroy()
end

local gui = Instance.new("ScreenGui")
gui.Name = "Chipeo"
gui.ResetOnSpawn = false
gui.DisplayOrder = 100
gui.Parent = playerGui

local function make(className, properties, parent)
    local object = Instance.new(className)

    for key, value in pairs(properties) do
        object[key] = value
    end

    object.Parent = parent
    return object
end

local function round(object)
    make("UICorner", {
        CornerRadius = UDim.new(0, 10)
    }, object)
end

local function makeButton(parent, text, y)
    local button = make("TextButton", {
        Size = UDim2.new(1, -24, 0, 38),
        Position = UDim2.new(0, 12, 0, y),
        BackgroundColor3 = BLUE,
        Text = text,
        TextColor3 = WHITE,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        Active = true,
        AutoButtonColor = true
    }, parent)

    round(button)
    return button
end

local function makeLabel(parent, text, y, height)
    return make("TextLabel", {
        Size = UDim2.new(1, -24, 0, height or 32),
        Position = UDim2.new(0, 12, 0, y),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = WHITE,
        TextSize = 13,
        TextWrapped = true,
        Font = Enum.Font.Gotham
    }, parent)
end

local function makePanel(name, height)
    local frame = make("Frame", {
        Name = name,
        Size = UDim2.fromOffset(310, height),
        Position = UDim2.new(0.5, -155, 0.5, -height / 2),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0,
        Visible = false,
        Active = true
    }, gui)

    round(frame)

    makeLabel(
        frame,
        "CHIPEO | " .. string.upper(name),
        4,
        34
    ).TextColor3 = BLUE

    -- CORREGIDO: argumentos en el orden correcto
    local close = make("TextButton", {
        Name = "Cerrar",
        Size = UDim2.fromOffset(30, 30),
        Position = UDim2.new(1, -36, 0, 4),
        BackgroundColor3 = Color3.fromRGB(190, 55, 65),
        Text = "X",
        TextColor3 = WHITE,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        Active = true
    }, frame)

    round(close)

    return frame, close
end

