-- PANELES
local owner, closeOwner = makePanel("OWNER", 410)
local client, closeClient = makePanel("CLIENTE", 310)

local function hidePanels()
    owner.Visible = false
    client.Visible = false
end

local function showCorrectPanel()
    hidePanels()
    openButton.Visible = false

    if accessType == "OWNER" then
        owner.Visible = true
    elseif accessType == "CLIENTE" then
        client.Visible = true
    end
end

closeOwner.Activated:Connect(function()
    owner.Visible = false
    openButton.Visible = true
end)

closeClient.Activated:Connect(function()
    client.Visible = false
    openButton.Visible = true
end)

openButton.Activated:Connect(showCorrectPanel)

-- OWNER: DESTINOS DE SESION
makeLabel(owner, "Guardar destinos durante esta sesion", 40, 28)

local savePosition = makeButton(
    owner, "GUARDAR POSICION ACTUAL", 72
)

local destinationName = make("TextBox", {
    Size = UDim2.new(1, -24, 0, 34),
    Position = UDim2.new(0, 12, 0, 116),
    BackgroundColor3 = DARK,
    TextColor3 = WHITE,
    PlaceholderText = "Nombre del destino",
    Text = "",
    Font = Enum.Font.Gotham,
    TextSize = 13,
    ClearTextOnFocus = false
}, owner)

round(destinationName)

local destinationStatus = makeLabel(
    owner, "No hay destinos guardados.", 154, 60
)

local listDestinations = makeButton(
    owner, "ACTUALIZAR LISTA", 216
)

local deleteDestination = makeButton(
    owner, "BORRAR ULTIMO DESTINO", 260
)

local openClientMenu = makeButton(
    owner, "ABRIR MENU CLIENTE", 304
)

local function refreshDestinations()
    if #destinations == 0 then
        destinationStatus.Text = "No hay destinos guardados."
        return
    end

    local lines = {}

    for index, destination in ipairs(destinations) do
        local p = destination.position

        table.insert(lines, string.format(
            "%d. %s (%.1f, %.1f, %.1f)",
            index,
            destination.name,
            p.X,
            p.Y,
            p.Z
        ))
    end

    destinationStatus.Text = table.concat(lines, "\n")
end

savePosition.Activated:Connect(function()
    local character = player.Character
    local root = character
        and character:FindFirstChild("HumanoidRootPart")

    if not root then
        destinationStatus.Text = "Personaje no disponible."
        return
    end

    local name = destinationName.Text:match("^%s*(.-)%s*$")

    if name == "" then
        name = "Destino " .. tostring(#destinations + 1)
    end

    table.insert(destinations, {
        name = name,
        position = root.Position
    })

    refreshDestinations()
end)

listDestinations.Activated:Connect(refreshDestinations)

deleteDestination.Activated:Connect(function()
    if #destinations > 0 then
        table.remove(destinations, #destinations)
    end

    refreshDestinations()
end)

openClientMenu.Activated:Connect(function()
    owner.Visible = false
    client.Visible = true
end)

-- CLIENTE: OPCIONES DE INTERFAZ
local farmStatus = makeLabel(
    client, "Auto Farm: DESACTIVADO", 42, 28
)

local farmToggle = makeButton(
    client, "ACTIVAR AUTO FARM", 76
)

local targetButton = makeButton(
    client, "OBJETIVO: MONEDAS", 122
)

local farmInfo = makeLabel(
    client,
    "Este control guarda una preferencia de interfaz. "
        .. "La recoleccion real requiere una integracion "
        .. "autorizada en el juego.",
    166,
    66
)

local viewDestinations = makeButton(
    client, "VER COORDENADAS GUARDADAS", 242
)

farmToggle.Activated:Connect(function()
    farmEnabled = not farmEnabled

    farmStatus.Text = farmEnabled
        and "Auto Farm: ACTIVADO (preferencia)"
        or "Auto Farm: DESACTIVADO"

    farmToggle.Text = farmEnabled
        and "DETENER AUTO FARM"
        or "ACTIVAR AUTO FARM"

    farmToggle.BackgroundColor3 = farmEnabled
        and Color3.fromRGB(190, 55, 65)
        or BLUE
end)

targetButton.Activated:Connect(function()
    if farmTarget == "Monedas" then
        farmTarget = "Objetos"
    elseif farmTarget == "Objetos" then
        farmTarget = "Dinero"
    else
        farmTarget = "Monedas"
    end

    targetButton.Text = "OBJETIVO: "
        .. string.upper(farmTarget)
end)

viewDestinations.Activated:Connect(refreshDestinations)

-- VALIDACION DE KEYS
local function checkKey()
    local key = keyBox.Text:match("^%s*(.-)%s*$")

    if key == OWNER_KEY then
        accessType = "OWNER"
    elseif key == CLIENT_KEY then
        accessType = "CLIENTE"
    else
        loginMessage.Text = "Key incorrecta"
        keyBox.Text = ""
        return
    end

    login.Visible = false
    loginMessage.Text = ""
    showCorrectPanel()
end

loginButton.Activated:Connect(checkKey)

keyBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        checkKey()
    end
end)

print("CHIPEO v3.0 FIX cargado correctamente")
